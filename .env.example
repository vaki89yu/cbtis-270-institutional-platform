# Base de datos
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Google OAuth institucional
# Crear credenciales en Google Cloud Console > APIs & Services > OAuth consent screen / Credentials
# Redirect URI autorizado: https://TU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo SMTP institucional para OTP real
# Puede ser Google Workspace SMTP relay, Microsoft 365 SMTP o proveedor oficial del dominio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DGPT Logística <no-reply@cetis270.edu.mx>"
